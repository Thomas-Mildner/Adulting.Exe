generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Appliance / Warranty Vault ─────────────────────────────────────────

model Appliance {
  id           String   @id @default(cuid())
  name         String
  category     String
  purchaseDate DateTime
  warrantyEnd  DateTime
  boxLocation  String
  status       String   // "protected" | "solo" | "zombie"
  brand        String
  price        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Service Providers & History ────────────────────────────────────────

model ServiceProvider {
  id        String   @id @default(cuid())
  name      String
  specialty String
  phone     String
  email     String
  website   String?
  rating    Int

  history  ServiceHistory[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceHistory {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  cost        Float
  taxRelevant Boolean

  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  invoiceId String?

  createdAt DateTime @default(now())
}

// ─── Invoices ───────────────────────────────────────────────────────────

model Invoice {
  id           String   @id @default(cuid())
  date         DateTime
  description  String
  amount       Float
  taxRelevant  Boolean
  fileName     String
  providerName String

  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId String

  createdAt DateTime @default(now())
}

// ─── Knowledge Base / Documents ─────────────────────────────────────────

model Document {
  id          String  @id @default(cuid())
  title       String
  category    String  // "Heating" | "Plumbing" | "Smart Home" | "Structural" | "General"
  type        String  // "pdf" | "markdown"
  description String
  content     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Maintenance Tasks ──────────────────────────────────────────────────

model MaintenanceTask {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  recurring String
  priority  String   // "high" | "medium" | "low"
  completed Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Lending / Lent Items ───────────────────────────────────────────────

model LentItem {
  id             String   @id @default(cuid())
  item           String
  borrower       String
  lentDate       DateTime
  expectedReturn DateTime
  trustLevel     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Utility / Meter Readings ───────────────────────────────────────────

model MeterReading {
  id          String @id @default(cuid())
  month       String @unique
  power       Float
  water       Float
  heating     Float
  powerCost   Float  @default(0)
  waterCost   Float  @default(0)
  heatingCost Float  @default(0)

  createdAt DateTime @default(now())
}

// ─── Wishlist / Projects ────────────────────────────────────────────────

model WishlistProject {
  id             String @id @default(cuid())
  title          String
  description    String
  estimatedCost  Float
  currentSavings Float
  urgency        String // "nice-to-have" | "should-do" | "need-soon" | "falling-apart"
  category       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Waste Calendar ───────────────────────────────────────────────────

model WasteType {
  id      String @id @default(cuid())
  name    String // e.g., "Restmüll", "Bio", "Papier", "Gelber Sack"
  color   String // tailwind color class or hex, e.g., "gray-700", "green-600"
  icon    String // lucide icon name

  pickups WastePickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WastePickup {
  id          String   @id @default(cuid())
  date        DateTime
  wasteType   WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Cascade)
  wasteTypeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── App Configuration ────────────────────────────────────────────────

model AppConfig {
  id          String   @id @default("default") // Only one row
  heatingType String   @default("Gas") // "Gas", "Oil", "Fernwärme", "Wärmepumpe", "Pellets"

  updatedAt DateTime @updatedAt
}

// ─── Insurance ──────────────────────────────────────────────────────────

model Insurance {
  id                   String   @id @default(cuid())
  providerName         String
  policyType           String
  customPolicyType     String?
  policyNumber         String
  premiumAmount        Float
  paymentFrequency     String
  deductible           Float
  startDate            DateTime
  endDate              DateTime?
  cancellationDeadline DateTime
  documentPath         String?
  claimsHotline        String
  agentEmail           String
  beneficiary          String?
  notes                String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Notification History ──────────────────────────────────────────────

model NotificationRead {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Room Chronicles ────────────────────────────────────────────────────

model Room {
  id          String   @id @default(cuid())
  name        String
  type        String   // "Kitchen", "Bedroom", "Bathroom", "Living Room", etc.
  floor       String?  // "Ground Floor", "1st Floor", "Basement", etc.
  description String?

  events RoomEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomEvent {
  id          String   @id @default(cuid())
  timestamp   DateTime
  category    String   // "Maintenance", "Aesthetics", "Incident", "Tech", "Surgery", "Band-aid", "Face-lift"
  description String
  metadata    String?  // JSON string for generic key-value data (paint brand, bulb specs, etc.)
  attachments String?  // JSON array of attachment paths/URLs
  vibeRating  Int?     // 1-5 stars rating

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
