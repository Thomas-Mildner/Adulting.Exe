DATABASE_URL="postgresql://adulting:<your-secure-password>@localhost:5432/adulting_exe?schema=public"

# Docker Compose secrets (required when using docker-compose.yml)
POSTGRES_USER=adulting
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_DB=adulting_exe
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=<your-secure-pgadmin-password>

# Optional: GitHub token for accessing private repository releases
# Required if the repository is private, optional for public repositories
# GITHUB_TOKEN="ghp_your_token_here"
