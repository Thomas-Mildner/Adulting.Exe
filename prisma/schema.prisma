generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appliance {
  id           String   @id @default(cuid())
  name         String
  category     String
  purchaseDate DateTime
  warrantyEnd  DateTime
  boxLocation  String
  status       String
  brand        String
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceProvider {
  id        String           @id @default(cuid())
  name      String
  specialty String
  phone     String
  email     String
  website   String?
  rating    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  invoices  Invoice[]
  history   ServiceHistory[]
}

model ServiceHistory {
  id          String          @id @default(cuid())
  date        DateTime
  description String
  cost        Float
  taxRelevant Boolean
  providerId  String
  invoiceId   String?
  createdAt   DateTime        @default(now())
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String          @id @default(cuid())
  date         DateTime
  description  String
  amount       Float
  taxRelevant  Boolean
  fileName     String
  providerName String
  providerId   String
  createdAt    DateTime        @default(now())
  provider     ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String
  type        String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaintenanceTask {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  recurring String
  priority  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LentItem {
  id             String   @id @default(cuid())
  item           String
  borrower       String
  lentDate       DateTime
  expectedReturn DateTime
  trustLevel     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MeterReading {
  id          String   @id @default(cuid())
  month       String   @unique
  power       Float
  water       Float
  heating     Float
  powerCost   Float    @default(0)
  waterCost   Float    @default(0)
  heatingCost Float    @default(0)
  createdAt   DateTime @default(now())
}

model WishlistProject {
  id             String   @id @default(cuid())
  title          String
  description    String
  estimatedCost  Float
  currentSavings Float
  urgency        String
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WasteType {
  id        String        @id @default(cuid())
  name      String
  color     String
  icon      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pickups   WastePickup[]
}

model WastePickup {
  id          String    @id @default(cuid())
  date        DateTime
  wasteTypeId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wasteType   WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id          String   @id @default("default")
  heatingType String   @default("Gas")
  updatedAt   DateTime @updatedAt
}

model Car {
  id                  String           @id @default(cuid())
  name                String
  brand               String
  model               String
  licensePlate        String
  purchaseDate        DateTime
  purchasePrice       Float
  nextInspection      DateTime?
  currentTireType     String           @default("summer")
  tireStorageLocation String?
  firstAidKitExpiry   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  documents           CarDocument[]
  maintenanceLogs     CarMaintenance[]
  fuelEntries         FuelEntry[]
  tollEntries         TollEntry[]
}

model CarMaintenance {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  cost        Float
  mileage     Int?
  category    String
  carId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model FuelEntry {
  id            String   @id @default(cuid())
  date          DateTime
  liters        Float
  pricePerLiter Float
  totalCost     Float
  mileage       Int?
  fuelType      String   @default("diesel")
  carId         String
  createdAt     DateTime @default(now())
  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model TollEntry {
  id        String   @id @default(cuid())
  date      DateTime
  cost      Float
  route     String?
  country   String?
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model CarDocument {
  id         String   @id @default(cuid())
  title      String
  category   String
  fileName   String
  uploadDate DateTime @default(now())
  carId      String
  createdAt  DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}
