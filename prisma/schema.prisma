generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appliance {
  id           String   @id @default(cuid())
  name         String
  category     String
  purchaseDate DateTime
  warrantyEnd  DateTime
  boxLocation  String
  status       String
  brand        String
  price        Float
  receiptPath  String?  // optional path to uploaded receipt/image
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceProvider {
  id        String           @id @default(cuid())
  name      String
  specialty String
  phone     String
  email     String
  website   String?
  rating    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  invoices  Invoice[]
  history   ServiceHistory[]
}

model ServiceHistory {
  id          String          @id @default(cuid())
  date        DateTime
  description String
  cost        Float
  taxRelevant Boolean
  providerId  String
  invoiceId   String?
  createdAt   DateTime        @default(now())
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String          @id @default(cuid())
  date         DateTime
  description  String
  amount       Float
  taxRelevant  Boolean
  fileName     String
  providerName String
  providerId   String
  createdAt    DateTime        @default(now())
  provider     ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String
  type        String
  description String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MaintenanceTask {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  recurring String
  priority  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LentItem {
  id             String   @id @default(cuid())
  item           String
  borrower       String
  lentDate       DateTime
  expectedReturn DateTime
  trustLevel     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MeterReading {
  id          String   @id @default(cuid())
  month       String   @unique
  power       Float
  water       Float
  heating     Float
  powerCost   Float    @default(0)
  waterCost   Float    @default(0)
  heatingCost Float    @default(0)
  createdAt   DateTime @default(now())
}

model WishlistProject {
  id             String   @id @default(cuid())
  title          String
  description    String
  estimatedCost  Float
  currentSavings Float
  urgency        String
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WasteType {
  id        String        @id @default(cuid())
  name      String
  color     String
  icon      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  pickups   WastePickup[]
}

model WastePickup {
  id          String    @id @default(cuid())
  date        DateTime
  wasteTypeId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  wasteType   WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id          String   @id @default("default")
  heatingType String   @default("Gas")
  updatedAt   DateTime @updatedAt
}

model Car {
  id                  String           @id @default(cuid())
  name                String
  brand               String
  model               String
  licensePlate        String
  purchaseDate        DateTime
  purchasePrice       Float
  nextInspection      DateTime?
  currentTireType     String           @default("summer")
  tireStorageLocation String?
  firstAidKitExpiry   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  documents           CarDocument[]
  maintenanceLogs     CarMaintenance[]
  fuelEntries         FuelEntry[]
  tollEntries         TollEntry[]
}

model CarMaintenance {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  cost        Float
  mileage     Int?
  category    String
  carId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model FuelEntry {
  id            String   @id @default(cuid())
  date          DateTime
  liters        Float
  pricePerLiter Float
  totalCost     Float
  mileage       Int?
  fuelType      String   @default("diesel")
  carId         String
  createdAt     DateTime @default(now())
  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model TollEntry {
  id        String   @id @default(cuid())
  date      DateTime
  cost      Float
  route     String?
  country   String?
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model CarDocument {
  id                      String   @id @default(cuid())
  title      String
  category   String
  fileName                String
  uploadDate DateTime @default(now())
  carId      String  onboardingCompleted  Boolean  @default(false)
  disabledModules String[] @default([]) // Module keys that are hidden from the sidebar
  tutorialCompletedModules String[] @default([]) // Module keys whose tutorial has been seen

  createdAt  DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

// ─── Insurance ──────────────────────────────────────────────────────────

model Insurance {
  id                   String   @id @default(cuid())
  providerName         String
  policyType           String
  customPolicyType     String?
  policyNumber         String
  premiumAmount        Float
  paymentFrequency     String
  deductible           Float
  startDate            DateTime
  endDate              DateTime?
  cancellationDeadline DateTime
  documentPath         String?
  claimsHotline        String
  agentEmail           String
  beneficiary          String?
  notes                String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Recurring Contracts / Subscriptions ──────────────────────────────

model Contract {
  id              String   @id @default(cuid())
  providerName    String
  accountId       String?
  monthlyCost     Float
  yearlyCost      Float?
  category        String   // "Utilities", "Entertainment", "Fitness", "Software", "Guilty Pleasure"
  lastUsedDate    DateTime?
  isTrial         Boolean  @default(false)
  trialEndDate    DateTime?
  nextBillingDate DateTime
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Notification History ──────────────────────────────────────────────

model NotificationRead {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Pet Management Hub ──────────────────────────────────────────────────

model Pet {
  id              String    @id @default(cuid())
  name            String
  species         String    // "Dog", "Cat", "Bird", "Rabbit", "Fish", "Other"
  breed           String?
  dateOfBirth     DateTime?
  microchipNumber String?
  color           String?
  photoPath       String?
  dietaryNeeds    String?
  medications     String?
  notes           String?

  vetRecords   VetRecord[]
  vaccinations Vaccination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VetRecord {
  id          String    @id @default(cuid())
  date        DateTime
  vetName     String
  description String
  cost        Float?
  nextVisit   DateTime?
  notes       String?

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vaccination {
  id          String    @id @default(cuid())
  name        String
  date        DateTime
  nextDueDate DateTime?
  vetName     String?
  batchNumber String?
  notes       String?

  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Identity Guard / Document Tracker ─────────────────────────────────

model Person {
  id        String   @id @default(cuid())
  name      String
  relation  String   // "Self", "Spouse", "Child", "Other"
  
  documents IdentityDocument[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdentityDocument {
  id                  String   @id @default(cuid())
  documentType        String   // "ID", "Passport", "Driver's License", "Visa", "Other"
  customDocumentType  String?  // For "Other" type
  documentNumber      String
  issueDate           DateTime
  expiryDate          DateTime
  photoFrontPath      String?
  photoBackPath       String?
  physicalLocation    String?  // Where the physical document is stored
  lostFoundGuide      String?  // Emergency steps if lost
  emergencyContact    String?  // Contact info for reporting lost/stolen
  notes               String?
  
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
